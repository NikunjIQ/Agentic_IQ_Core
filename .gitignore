# Secrets — never commit these.
# Patterns are unanchored (no leading slash) so they match at ANY depth:
# ".streamlit/secrets.toml" would only have matched the repo root, which let
# frontend/.streamlit/secrets.toml through.
.env
.env.*
!.env.example
credentials.json
authentication.json
# The database and its WAL/SHM side files. secret.key is covered by *.key.
iqcore.db*
**/.streamlit/secrets.toml
secrets.toml
*.pem
*.key

# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
venv/
.venv/
env/

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Probe output — scratch, not source
ceph_probe.json
probe_*.json
graph.png

# Ticket assist output — real ticket text and model suggestions, not source
ticket_assist.jsonl
ticket_assist_review.csv
