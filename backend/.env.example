# Copy to .env and fill in real values. Never commit the filled-in .env.

# Groq API (LLM provider)
GROQ_API_KEY=

# Zabbix — network devices, Windows hosts
ZABBIX_URL=http://your-zabbix-host:8080
# Username and password only: an API token expires underneath the app.
ZABBIX_USER=
ZABBIX_PASS=

# Zammad — helpdesk ticketing
ZAMMAD_URL=http://your-zammad-host:8082
ZAMMAD_API_TOKEN=
ZAMMAD_USER=
ZAMMAD_PASS=

# Ticket assist — IQ Core's only write. When Zammad reports a new Zabbix
# ticket, IQ Core adds a suggested fix to it as an internal note.
#   off      (default) the webhook is accepted and nothing else happens
#   dry_run  the suggestion is generated and logged to backend/ticket_assist.jsonl
#   write    the suggestion is also written to the ticket
TICKET_ASSIST_MODE=off
# Shared secret set as the "signature token" on the Zammad webhook. Required:
# without it every call to /hooks/zammad/ticket-created is refused.
ZAMMAD_WEBHOOK_SECRET=
# A Zammad token with ticket.agent only, owned by a dedicated "IQ Core" user.
# Ticket assist reads the ticket and writes the note with it; nothing else uses it.
# It also needs ZAMMAD_URL above set in this file.
ZAMMAD_WRITE_TOKEN=
# Most tickets per day that get a suggestion. An alert storm stops here.
TICKET_ASSIST_DAILY_LIMIT=40
# Seconds a ticket must be old before the note is written (default 90).
# TICKET_ASSIST_WRITE_DELAY=90

# Ansible — read-only diagnostic playbooks run through Semaphore (ansible/Ansible_Setup.md).
# When a ticket's alert has a playbook, its output is added to the ticket assist note.
#   off      (default) never contacts Ansible
#   dry_run  checks the playbook and host exist and logs what would run; starts nothing
#   run      runs the playbook on the alert's host and adds its output
ANSIBLE_MODE=off
ANSIBLE_URL=http://localhost:3000
# API token of the Semaphore user "iqcore" (Task Runner in the IQ Core project only).
ANSIBLE_TOKEN=
ANSIBLE_PROJECT_ID=1

# LDAP — sign in with company directory accounts (OpenLDAP, dc=example,dc=local).
# Leave LDAP_URL empty to keep local accounts only. Local accounts are always
# checked first: create a local admin BEFORE turning this on and keep it as the
# break-glass login for when the directory is down.
# Plain ldap:// sends passwords in clear text; use ldaps://host:636 or
# LDAP_START_TLS=true anywhere but the lab. Certificates are always verified.
LDAP_URL=
LDAP_START_TLS=false
# PEM file of the CA that signed the LDAP server's certificate, if not a public one.
LDAP_CA_FILE=
# A dedicated read-only service account, not cn=admin.
LDAP_BIND_DN=
LDAP_BIND_PASSWORD=
LDAP_USER_BASE=ou=People,dc=example,dc=local
LDAP_USER_ATTR=uid
# Members of this group are IQ Core admins; everyone else in the directory is a
# plain user. Empty means no directory user is an admin.
LDAP_ADMIN_GROUP=

# Prometheus — Linux cluster, OpenStack, containers
PROMETHEUS_URL=http://your-prometheus-host:9090
PROMETHEUS_USER=
PROMETHEUS_PASS=
# Alternative to basic auth:
PROMETHEUS_TOKEN=

# LangSmith tracing (optional — leave blank to disable)
LANGCHAIN_TRACING_V2=false
LANGCHAIN_ENDPOINT=
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=

# OpenSearch — OpenStack application logs (fluentd -> flog-* indices)
OPENSEARCH_URL=http://your-opensearch-host:9200
OPENSEARCH_INDEX=flog-*
OPENSEARCH_USER=
OPENSEARCH_PASS=

# Ceph — storage cluster (mgr dashboard REST API)
# Token auth: POST /api/auth with username+password returns a short-lived JWT.
# There is no long-lived API key by default, so user and password are required.
# Usually HTTPS on 8443 with a self-signed certificate.
CEPH_URL=https://your-ceph-host:8443
CEPH_USER=
CEPH_PASS=
# Set to false only if the dashboard uses a self-signed certificate.
CEPH_VERIFY_TLS=false

# ---------------------------------------------------------------------------
# Second OpenSearch cluster — one host, two indices
# ---------------------------------------------------------------------------
# OPENSEARCH_* above is the ORIGINAL cluster (OpenStack service logs, flog-*).
# This is a separate deployment on its own host with its own credentials,
# holding two different indices. Credentials are declared once because both
# indices live on the same cluster.
OPENSEARCH2_URL=https://your-second-opensearch-host:9200
OPENSEARCH2_USER=
OPENSEARCH2_PASS=

# Logs produced BY the monitoring and ticketing platforms themselves.
# Not the same as ZABBIX_URL / ZAMMAD_URL above: those return live state
# (what is broken now, which tickets are open now), this index holds what
# those applications logged after the fact.
OPENSEARCH2_ITSM_INDEX=

# Ceph's own log lines, archived.
# Not the same source as CEPH_URL's /api/logs, which returns only the recent
# in-memory cluster log — a disk that failed months ago has long since aged
# out of that, but should still be in this index.
OPENSEARCH2_CEPH_INDEX=
# Self-signed certificate on this cluster, same as CEPH_VERIFY_TLS.
OPENSEARCH2_VERIFY_TLS=false
